{
  "id": "demo",
  "name": "Demo Client",
  "auth": {
    "allowedEmails": ["demo@analytics.local"],
    "allowedDomains": []
  },
  "bigquery": {
    "projectId": "demo-project",
    "dataset": "analytics_demo",
    "location": "US"
  },
  "dashboard": {
    "title": "Demo Analytics",
    "defaultPageId": "overview",
    "defaultPreset": "28d",
    "pages": [
      {
        "id": "overview",
        "title": "Overview",
        "description": "Executive snapshot of site health and traffic trends.",
        "kind": "metrics",
        "widgets": [
          { "id": "kpi-sessions", "type": "kpi", "metric": "sessions", "label": "Sessions" },
          { "id": "kpi-users", "type": "kpi", "metric": "users", "label": "Users" },
          { "id": "kpi-pageviews", "type": "kpi", "metric": "pageviews", "label": "Pageviews" },
          { "id": "kpi-conversions", "type": "kpi", "metric": "conversions", "label": "Conversions" },
          { "id": "trend-sessions", "type": "trend", "metric": "sessions" }
        ],
        "plannedSections": []
      },
      {
        "id": "engagement",
        "title": "User Engagement",
        "kind": "metrics",
        "widgets": [],
        "plannedSections": [
          { "id": "engaged-sessions", "title": "Engaged sessions" }
        ]
      },
      {
        "id": "acquisition",
        "title": "Acquisition & Traffic",
        "kind": "metrics",
        "widgets": [{ "id": "sources", "type": "sources" }],
        "plannedSections": []
      },
      {
        "id": "commentary",
        "title": "Qualitative Analytics Commentary",
        "description": "What the numbers show this period for marketing, sales, manufacturing, and inventory.",
        "kind": "aiCommentary"
      },
      {
        "id": "insights",
        "title": "Inferences & Suggestions",
        "description": "Conclusions and recommended next steps for marketing, sales, manufacturing, and inventory.",
        "kind": "aiInsights"
      }
    ]
  }
}
