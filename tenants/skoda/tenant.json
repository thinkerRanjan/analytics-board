  "dashboard": {
    "title": "Skoda Analytics",
    "defaultPageId": "overview",
    "defaultPreset": "28d",
    "pages": [
      {
        "id": "overview",
        "title": "Overview",
        "description": "Executive snapshot of site health and traffic trends.",
        "kind": "metrics",
        "widgets": [
          {
            "id": "kpi-sessions",
            "type": "kpi",
            "metric": "sessions",
            "label": "Sessions"
          },
          {
            "id": "kpi-users",
            "type": "kpi",
            "metric": "users",
            "label": "Users"
          },
          {
            "id": "kpi-pageviews",
            "type": "kpi",
            "metric": "pageviews",
            "label": "Pageviews"
          },
          {
            "id": "kpi-conversions",
            "type": "kpi",
            "metric": "conversions",
            "label": "Test drive leads"
          },
          {
            "id": "trend-sessions",
            "type": "trend",
            "metric": "sessions"
          }
        ],
        "plannedSections": []
      },
      {
        "id": "engagement",
        "title": "User Engagement",
        "description": "Depth of visit, returning users, and interaction quality.",
        "kind": "metrics",
        "widgets": [
          {
            "id": "trend-active-users",
            "type": "trend",
            "metric": "activeUsers",
            "title": "Active users",
            "subtitle": "Users with at least one engaged session",
            "span": "half"
          },
          {
            "id": "trend-new-users",
            "type": "trend",
            "metric": "newUsers",
            "title": "New users",
            "subtitle": "First-time visitors each day",
            "span": "half"
          },
          {
            "id": "trend-session-time",
            "type": "trend",
            "metric": "avgSessionSeconds",
            "title": "Average session time",
            "subtitle": "Mean engagement time per session",
            "span": "full"
          },
          {
            "id": "event-configurator-started",
            "type": "eventTrend",
            "eventName": "configurator_started",
            "title": "Configurator started",
            "subtitle": "Times the configurator was launched",
            "span": "half"
          },
          {
            "id": "event-ai-chatbot-open",
            "type": "eventTrend",
            "eventName": "ai_chatbot_open_clicked",
            "title": "AI chatbot opened",
            "subtitle": "Times the chatbot was opened",
            "span": "half"
          }
        ],
        "plannedSections": []
      },
      {
        "id": "top-products",
        "title": "Top Product Overview",
        "description": "Ranked models and products by traffic and interest.",
        "kind": "metrics",
        "widgets": [
          {
            "id": "configurator-opens-by-model",
            "type": "eventBreakdown",
            "eventName": "configurator_loaded",
            "param": "model",
            "title": "Configurator opens by model",
            "subtitle": "Times each model was loaded in the configurator",
            "valueLabel": "Opens",
            "limit": 10,
            "span": "full"
          },
          {
            "id": "top-variant-per-model",
            "type": "eventBreakdown",
            "eventName": "variant_selected",
            "param": "variant",
            "groupBy": "model",
            "title": "Top variants by model",
            "subtitle": "Most selected trim for each car",
            "valueLabel": "Selections",
            "limit": 1,
            "span": "full"
          },
          {
            "id": "top-color-per-model",
            "type": "eventBreakdown",
            "eventName": "color_change_clicked",
            "param": "color",
            "groupBy": "model",
            "title": "Top colours by model",
            "subtitle": "Most previewed paint colour for each car",
            "valueLabel": "Previews",
            "limit": 1,
            "span": "full"
          }
        ],
        "plannedSections": []
      },
      {
        "id": "product-pages",
        "title": "Product Pages",
        "description": "Analytics for each car model in the configurator.",
        "kind": "productIndex",
        "sourceEvent": "configurator_loaded",
        "sourceParam": "model",
        "widgets": [
          {
            "id": "trend-configurator-loaded",
            "type": "eventTrend",
            "eventName": "configurator_loaded",
            "title": "Configurator opens",
            "subtitle": "Times this model was loaded in the configurator",
            "span": "full"
          },
          {
            "id": "top-variants",
            "type": "eventBreakdown",
            "eventName": "variant_selected",
            "param": "variant",
            "title": "Top variants",
            "subtitle": "Most selected trims for this model",
            "valueLabel": "Selections",
            "limit": 10,
            "span": "half"
          },
          {
            "id": "top-colors",
            "type": "eventBreakdown",
            "eventName": "color_change_clicked",
            "param": "color",
            "title": "Top colours",
            "subtitle": "Most previewed paint colours for this model",
            "valueLabel": "Previews",
            "limit": 10,
            "span": "half"
          }
        ],
        "plannedSections": []
      },
      {
        "id": "product-variants",
        "title": "Product Variant Pages",
