        "kind": "metrics",
        "widgets": [],
        "plannedSections": [
          {
            "id": "variant-paths",
            "title": "Variant page paths",
            "description": "Traffic to trim and configuration pages."
          },
          {
            "id": "configurator-usage",
            "title": "Configurator usage",
            "description": "Engagement with build-and-price flows."
          }
        ]
      },
      {
        "id": "audience",
        "title": "Audience & Demographics",
        "description": "Geography, devices, and audience composition.",
        "kind": "metrics",
        "widgets": [
          {
            "id": "breakdown-device-category",
            "type": "breakdown",
            "dimension": "deviceCategory",
            "chart": "donut",
            "title": "Device category",
            "subtitle": "Mobile, desktop, and tablet split",
            "span": "half"
          },
          {
            "id": "breakdown-user-type",
            "type": "breakdown",
            "dimension": "userType",
            "chart": "donut",
