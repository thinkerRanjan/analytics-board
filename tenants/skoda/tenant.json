            "span": "half"
          },
          {
            "id": "breakdown-browser",
            "type": "breakdown",
            "dimension": "browser",
            "chart": "bar",
            "title": "Browsers",
            "subtitle": "Rendering environments to test against",
            "limit": 8,
            "span": "full"
          }
        ],
        "plannedSections": []
