# Auth.js / NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# App URL (Auth.js)
# Local npm: http://localhost:3000
# Docker Compose: http://localhost:8081 (8080 is often taken by other stacks)
AUTH_URL=http://localhost:8081

# Host port mapping for docker compose (container always uses 8080 internally)
PORT=8081

# Path to tenants/ directory (Docker image uses /app/tenants; leave empty for local npm defaults)
TENANTS_DIR=

# Shared BigQuery service account (dataset/project come from each tenants/*/tenant.json)
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_CREDENTIALS_JSON=

# Set true to use sample data without BigQuery (local UI / default compose)
USE_MOCK_DATA=true

# AI commentary (Qualitative Analytics Commentary page)
# Cached per tenant + date range under COMMENTARY_CACHE_DIR (defaults to OS temp)
GEMINI_API_KEY=
# OPENAI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# OPENAI_MODEL=gpt-4o
# COMMENTARY_CACHE_DIR=
